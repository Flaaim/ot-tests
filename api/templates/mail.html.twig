<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="ru" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% block title %}OT-TESTS.RU{% endblock %}</title>
    <style type="text/css">
        body {
            margin: 0;
            padding: 0;
            min-width: 100%;
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        table { border-collapse: collapse; border-spacing: 0; }
    </style>
</head>
<body style="background-color: #f4f4f5; margin: 0; padding: 0;">

<span style="display:none;font-size:1px;color:#f4f4f5;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;">
    {% block preheader %}Важное уведомление{% endblock %}
</span>

<table cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f4f5;">
    <tr>
        <td align="center" style="padding: 40px 15px;">
            <table cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
                <!-- Шапка -->
                <tr>
                    <td style="padding: 32px 32px 24px 32px; border-bottom: 1px solid #f4f4f5; text-align: left;">
                        <span style="color: #09090b; font-size: 20px; font-weight: 700; letter-spacing: -0.5px;">
                            OT-TESTS.RU
                        </span>
                    </td>
                </tr>
                <!-- Тело письма -->
                <tr>
                    <td style="padding: 32px; text-align: left;">
                        {% block body %}{% endblock %}
                    </td>
                </tr>
                <!-- Подвал -->
                <tr>
                    <td style="background-color: #fafafa; padding: 24px 32px; text-align: left; border-top: 1px solid #e4e4e7;">
                        <p style="margin: 0; font-size: 13px; color: #71717a; line-height: 20px;">
                            Вы получили это письмо, так как этот адрес был указан при регистрации.<br>
                            Если вы не отправляли запрос, просто проигнорируйте это сообщение.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
