{% extends 'mail.html.twig' %}

{% block title %}Подтверждение нового email | OT-TESTS.RU{% endblock %}
{% block preheader %}Подтвердите ваш новый адрес электронной почты для привязки к аккаунту.{% endblock %}

{% block body %}
    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; color: #09090b;">
        Подтверждение email
    </h1>

    <p style="margin: 0 0 24px 0; font-size: 15px; color: #3f3f46; line-height: 24px;">
        Здравствуйте! Мы получили запрос на изменение адреса электронной почты для вашего аккаунта. Чтобы подтвердить этот новый адрес, нажмите на кнопку ниже:
    </p>

    {% set url = frontend_url('email/change/confirm', {'token': token } ) %}

    <!-- Кнопка действия (в стиле shadcn Button) -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 32px;">
        <tr>
            <td align="left">
                <table border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td align="center" style="border-radius: 6px; background-color: #18181b;">
                            <a href="{{ url }}" target="_blank" style="font-size: 14px; font-weight: 500; color: #ffffff; text-decoration: none; border-radius: 6px; padding: 10px 20px; border: 1px solid #18181b; display: inline-block;">
                                Подтвердить email
                            </a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Блок предупреждения (в стиле shadcn Alert) -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px; background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 8px;">
        <tr>
            <td style="padding: 16px;">
                <p style="margin: 0 0 6px 0; font-size: 14px; color: #09090b; font-weight: 600; letter-spacing: -0.2px;">
                    Важно
                </p>
                <p style="margin: 0; font-size: 14px; color: #71717a; line-height: 20px;">
                    Если вы не инициировали смену адреса электронной почты, просто проигнорируйте это сообщение. Ваш текущий email-адрес останется прежним.
                </p>
            </td>
        </tr>
    </table>

    <!-- Ссылка для ручного копирования -->
    <p style="margin: 0 0 8px 0; font-size: 14px; color: #71717a;">
        Если кнопка не работает, скопируйте и вставьте эту ссылку в адресную строку браузера:
    </p>
    <p style="margin: 0; font-size: 14px; word-break: break-all;">
        <a style="color: #18181b; text-decoration: underline; text-underline-offset: 4px;" href="{{ url }}">{{ url }}</a>
    </p>

{% endblock %}
