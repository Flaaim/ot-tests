{% extends 'mail.html.twig' %}

{% block title %}Создание пользователя | OT-TESTS.RU{% endblock %}
{% block preheader %}Ваши данные для входа на платформу OT-TESTS.RU.{% endblock %}

{% block body %}
    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; color: #09090b;">
        Доступ к платформе
    </h1>

    <p style="margin: 0 0 24px 0; font-size: 15px; color: #3f3f46; line-height: 24px;">
        Здравствуйте! Для вас была создана новая учетная запись на сайте <strong>ot-tests.ru</strong>. Пожалуйста, используйте приведенные ниже данные для входа в систему.
    </p>

    <!-- Блок с данными для входа (стилизован под shadcn Card) -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 32px; background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px;">
        <tr>
            <td style="padding: 20px; font-size: 15px; color: #09090b;">
                <p style="margin: 0 0 16px 0;">
                    <span style="color: #71717a; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px;">Email (Логин)</span>
                    <strong>{{ email }}</strong>
                </p>
                <p style="margin: 0;">
                    <span style="color: #71717a; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px;">Пароль</span>
                    <strong>{{ password }}</strong>
                </p>
            </td>
        </tr>
    </table>

    <!-- Кнопка действия -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 32px;">
        <tr>
            <td align="left">
                <table border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td align="center" style="border-radius: 6px; background-color: #18181b;">
                            <a href="https://ot-tests.ru/auth/join" target="_blank" style="font-size: 14px; font-weight: 500; color: #ffffff; text-decoration: none; border-radius: 6px; padding: 10px 20px; border: 1px solid #18181b; display: inline-block;">
                                Войти в аккаунт
                            </a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Блок с рекомендацией (замена нерелевантного текста про сброс пароля) -->
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px; background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 8px;">
        <tr>
            <td style="padding: 16px;">
                <p style="margin: 0 0 6px 0; font-size: 14px; color: #09090b; font-weight: 600; letter-spacing: -0.2px;">
                    Совет по безопасности
                </p>
                <p style="margin: 0; font-size: 14px; color: #71717a; line-height: 20px;">
                    В целях безопасности мы рекомендуем сменить этот сгенерированный пароль в личном кабинете после первого входа. Если вы не ожидаете это письмо, просто проигнорируйте его.
                </p>
            </td>
        </tr>
    </table>

{% endblock %}
